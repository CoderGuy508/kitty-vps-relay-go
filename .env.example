# Server-only configuration for the Kitty Partner Relay bridge.
# Copy these values into /etc/kitty-vps-relay.env on the MassiveGrid VPS.
# Do not commit that file and do not put any of these values in a userscript.

# The partner supplies this secret. It is used only to derive per-connection
# TOTP values for the partner upstream.
PARTNER_SECRET_B64=replace-with-partner-secret
PARTNER_UPSTREAM=wss://relay.rrelayservers.win/ws

# Generate a separate random value. Set the identical value as
# BOT_RELAY_SIGNING_SECRET on kitty-account-service.
RELAY_TOKEN_SIGNING_SECRET=replace-with-a-different-random-secret

RELAY_MAX_TUNNELS=65
RELAY_TARGET_SUFFIXES=moomoo.io
RELAY_BIND_HOST=127.0.0.1
PORT=10000

# Optional development-only origins, comma separated. Leave empty in production.
RELAY_ALLOWED_ORIGINS=
